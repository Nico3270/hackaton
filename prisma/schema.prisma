generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums generales
enum TipoServicio {
  PuestoSalud
  Hospital
  CampanaMovil
}

enum Disponibilidad {
  Disponible
  Parcial
  NoDisponible
  EnMantenimiento
}

enum NivelComplejidad {
  Baja
  Media
  Alta
}

enum EstadoEmergencia {
  Normal
  Emergencia
}

enum Prioridad {
  Baja
  Media
  Alta
}

enum TipoCaracter {
  Municipal
  Departamental
  Nacional
}

enum FactorEstacional {
  Normal
  Lluvias
  Sequia
  Epidemia
  Festividades
  InviernoFrio
  CalorExtremo
  EventosAgricolas
  EmergenciasNaturales
}

enum Role {
  Administrador
  ServicioSalud
  Usuario
  Invitado
}

enum ValoracionSatisfaccion {
  MuyInsatisfecho
  Insatisfecho
  Neutral
  Satisfecho
  MuySatisfecho
}

enum FrecuenciaSintomas {
  Raro
  Ocasional
  Frecuente
  Constante
}

enum SatisfaccionGeneral {
  Malo
  Regular
  Bueno
}

// Modelos de Servicios de Salud
model ServicioSalud {
  id                      String             @id @default(uuid())
  tipo                    TipoServicio
  nombre                  String
  nit                     String             @unique
  disponibilidad          Disponibilidad
  codigoPrestador         String             @unique
  direccion               String
  departamento            String
  ciudad                  String
  caracter                TipoCaracter
  descripcion             String?
  estadoEmergencia        EstadoEmergencia?
  prioridad               Prioridad?
  capacidadDiaria         Int?
  especialidades          String[] // Corregido: Lista no opcional
  personalMedico          Int?
  nivelComplejidad        NivelComplejidad?
  camasDisponibles        Int?
  camasTotales            Int?
  capacidadEstimada       Int?
  serviciosEspecializados String[] // Corregido: Lista no opcional
  equipoDiagnostico       String[] // Corregido: Lista no opcional
  contactoEmergencia      String?
  serviciosOfrecidos      String[] // Corregido: Lista no opcional
  ruta              String?        // Añadido: Opcional para campañas móviles
  fechaInicio       DateTime?      // Añadido: Opcional para campañas móviles
  fechaFin          DateTime?      // Añadido: Opcional para campañas móviles
  registrosDemanda        RegistroDemanda[]
  reportesComunidad       ReporteComunidad[]
  registrosConsulta       RegistroConsulta[]
  fechaCreacion           DateTime           @default(now())
  fechaActualizacion      DateTime           @updatedAt

  @@index([departamento, ciudad])
  @@index([tipo])
  @@index([disponibilidad])
  @@index([nit])
  @@index([codigoPrestador])
}

// Modelos de Reporte de Servicios de Salud
model RegistroDemanda {
  id               String           @id @default(uuid())
  servicioId       String
  servicio         ServicioSalud    @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  fecha            DateTime
  atenciones       Int
  demandaEstimada  Float?
  factorEstacional FactorEstacional
  tiposDemanda     String[] // Corregido: String[] flexible
  notas            String?
  fechaCreacion    DateTime         @default(now())

  @@unique([servicioId, fecha])
  @@index([servicioId])
  @@index([fecha])
  @@index([servicioId, fecha])
  @@index([factorEstacional])
  @@index([servicioId, fecha, factorEstacional])
}

// Modelos de Usuarios
model Usuario {
  id                 String             @id @default(uuid())
  nombre             String
  apellido           String
  contraseña        String
  email              String             @unique
  departamento       String
  ciudad             String
  fechaNacimiento    DateTime
  emailVerified      DateTime?
  role               Role               @default(Usuario)
  fechaCreacion      DateTime           @default(now())
  fechaActualizacion DateTime           @updatedAt
  reportesComunidad  ReporteComunidad[]
  registrosConsulta  RegistroConsulta[]

  @@index([email])
  @@index([departamento, ciudad])
}

enum MotivoVisita {
  ReportarSintomas
  ReportarEnfermedad
  CitaControl
  SolicitudCita
  EvaluacionServicio
  ReclamarMedicamentos
  
}

enum AspectoMejorar {
  TiempoEspera
  AmabilidadPersonal
  DisponibilidadCitas
  Infraestructura
  CalidadDiagnostico
  Otros
}

model ReporteComunidad {
  id                   String                  @id @default(uuid())
  motivoVisita         MotivoVisita // Cambiado de tipo a motivoVisita
  ciudad               String
  departamento         String?
  descripcion          String?
  disponibilidad       Disponibilidad?
  email                String?
  fecha                DateTime                @default(now())
  aprobado             Boolean                 @default(false)
  servicioId           String?
  servicio             ServicioSalud?          @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  ratingSatisfaccion   Int? // Escala 1-5, disponible para todos los motivos
  recomendarServicio   Boolean? // NPS-like, disponible para todos
  calidadAtencion      ValoracionSatisfaccion? // Enum para calidad, disponible para todos
  tiempoEspera         Int? // Métricas operativas, disponible para todos
  aspectosMejorar      AspectoMejorar[]        @default([]) // Tags estructurados, disponible para todos
  sintomas             String[]                @default([]) // Para ReportarSintomas, ReportarEnfermedad
  frecuenciaSintomas   FrecuenciaSintomas? // Para ReportarSintomas, ReportarEnfermedad
  duracionSintomasDias Int? // Para ReportarSintomas, ReportarEnfermedad
  usuarioId            String?
  usuario              Usuario?                @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ciudad])
  @@index([fecha])
  @@index([motivoVisita, aprobado]) // Actualizado
  @@index([motivoVisita]) // Actualizado
  @@index([departamento, fecha, motivoVisita])
  @@index([servicioId])
  @@index([ratingSatisfaccion])
  @@index([servicioId, ratingSatisfaccion])
  @@index([ciudad, motivoVisita]) // Actualizado
  @@index([usuarioId])
  @@index([email])
}

model RegistroConsulta {
  id            String        @id @default(uuid())
  usuarioId     String
  usuario       Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  servicioId    String
  servicio      ServicioSalud @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  fecha         DateTime
  tiposDemanda  String[] // Corregido: String[] flexible
  notas         String?
  fechaCreacion DateTime      @default(now())

  @@unique([usuarioId, servicioId, fecha])
  @@index([usuarioId])
  @@index([servicioId])
  @@index([fecha])
}
