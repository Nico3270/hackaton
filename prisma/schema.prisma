generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums generales
enum TipoServicio {
  PuestoSalud
  Hospital
  CampanaMovil
}

enum Disponibilidad {
  Disponible
  Parcial
  NoDisponible
  EnMantenimiento
}

enum NivelComplejidad {
  Baja
  Media
  Alta
}

enum EstadoEmergencia {
  Normal
  Emergencia
}

enum Prioridad {
  Baja
  Media
  Alta
}

enum TipoCaracter {
  Municipal
  Departamental
  Nacional
}

enum FactorEstacional {
  Normal
  Lluvias
  Sequia
  Epidemia
  Festividades
  InviernoFrio
  CalorExtremo
  EventosAgricolas
  EmergenciasNaturales
}

enum Role {
  Administrador
  ServicioSalud
  Usuario
  Invitado
}

enum TipoReporte {
  SintomasFrecuentes
  DisponibilidadCampana
  EncuestaSatisfaccion
  Enfermedades
  CitaControl
  SolicitudCita
}

enum ValoracionSatisfaccion {
  MuyInsatisfecho
  Insatisfecho
  Neutral
  Satisfecho
  MuySatisfecho
}

enum FrecuenciaSintomas {
  Raro
  Ocasional
  Frecuente
  Constante
}

enum SatisfaccionGeneral {
  Malo
  Regular
  Bueno
}

// Modelos de Servicios de Salud
model ServicioSalud {
  id                        String               @id @default(uuid())
  tipo                      TipoServicio
  nombre                    String
  nit                       String               @unique
  disponibilidad            Disponibilidad
  codigoPrestador           String               @unique
  direccion                 String
  departamento              String
  ciudad                    String
  caracter                  TipoCaracter
  descripcion               String?
  estadoEmergencia          EstadoEmergencia?
  prioridad                 Prioridad?
  capacidadDiaria           Int?
  especialidades            String[]             // Corregido: Lista no opcional
  personalMedico            Int?
  nivelComplejidad          NivelComplejidad?
  camasDisponibles          Int?
  camasTotales              Int?
  capacidadEstimada         Int?
  serviciosEspecializados   String[]             // Corregido: Lista no opcional
  equipoDiagnostico         String[]            // Corregido: Lista no opcional
  contactoEmergencia        String?
  serviciosOfrecidos        String[]             // Corregido: Lista no opcional
  registrosDemanda          RegistroDemanda[]
  reportesComunidad         ReporteComunidad[]
  registrosConsulta         RegistroConsulta[]
  fechaCreacion             DateTime             @default(now())
  fechaActualizacion        DateTime             @updatedAt

  @@index([departamento, ciudad])
  @@index([tipo])
  @@index([disponibilidad])
  @@index([fechaInicio, fechaFin])
  @@index([nit])
  @@index([codigoPrestador])
}

// Modelos de Reporte de Servicios de Salud
model RegistroDemanda {
  id                String             @id @default(uuid())
  servicioId        String
  servicio          ServicioSalud      @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  fecha             DateTime
  atenciones        Int
  demandaEstimada   Float?
  factorEstacional  FactorEstacional
  tiposDemanda      String[]           // Corregido: String[] flexible
  notas             String?
  fechaCreacion     DateTime           @default(now())

  @@index([servicioId])
  @@index([fecha])
  @@index([servicioId, fecha])
  @@index([factorEstacional])
  @@unique([servicioId, fecha])
}



// Modelos de Usuarios
model Usuario {
  id                   String             @id @default(uuid())
  nombre               String
  apellido             String
  contraseña     String
  email           String        @unique
  departamento         String
  ciudad               String
  fechaNacimiento      DateTime
  emailVerified   DateTime?
  role                 Role               @default(Usuario)
  fechaCreacion        DateTime           @default(now())
  fechaActualizacion   DateTime           @updatedAt
  reportesComunidad    ReporteComunidad[]
  registrosConsulta    RegistroConsulta[]

  @@index([email])
  @@index([departamento, ciudad])
}

model ReporteComunidad {
  id                    String                  @id @default(uuid())
  tipo                  TipoReporte
  ciudad                String
  departamento          String?
  sintomas              String[]                // Corregido: Lista no opcional
  frecuenciaSintomas    FrecuenciaSintomas?
  duracionSintomasDias  Int?
  descripcion           String?
  disponibilidad        String?
  email                 String?
  fecha                 DateTime                @default(now())
  aprobado              Boolean                 @default(false)
  servicioId            String?
  servicio              ServicioSalud?          @relation(fields: [servicioId], references: [id], onDelete: SetNull)
  valoracion            ValoracionSatisfaccion?
  tiempoEspera          Int?
  sintomasPostAtencion  String[]                // Corregido: Lista no opcional
  satisfaccionGeneral   SatisfaccionGeneral?
  usuarioId             String?
  usuario               Usuario?                @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([ciudad])
  @@index([fecha])
  @@index([tipo, aprobado])
  @@index([tipo])
  @@index([servicioId])
  @@index([valoracion])
  @@index([usuarioId])
  @@index([email])
}

model RegistroConsulta {
  id            String         @id @default(uuid())
  usuarioId     String
  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  servicioId    String
  servicio      ServicioSalud  @relation(fields: [servicioId], references: [id], onDelete: Cascade)
  fecha         DateTime
  tiposDemanda  String[]       // Corregido: String[] flexible
  notas         String?
  fechaCreacion DateTime       @default(now())

  @@index([usuarioId])
  @@index([servicioId])
  @@index([fecha])
  @@unique([usuarioId, servicioId, fecha])
}